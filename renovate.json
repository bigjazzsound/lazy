{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended"],

  "customManagers": [
    {
      "customType": "regex",
      "description": "lazy.nvim plugin tag/version updates",
      "managerFilePatterns": ["(^|/)lua/plugins/.*\\.lua$"],
      "matchStrings": [
        "\\{\\s*\"(?<depName>[^\\\"]+/[^\\\"]+)\".*?(?:version|tag)\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "lazy.nvim commit pin updates",
      "managerFilePatterns": ["(^|/)lua/plugins/.*\\.lua$"],
      "matchStrings": [
        "\\{\\s*\"(?<depName>[^\\\"]+/[^\\\"]+)\".*?commit\\s*=\\s*\"(?<currentValue>[a-f0-9]+)\""
      ],
      "datasourceTemplate": "github-commits",
      "versioningTemplate": "git"
    }
  ]
}

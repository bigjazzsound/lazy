{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended"],

  "customManagers": [
    {
      "description": "lazy.nvim plugin tag/version updates",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)lua/plugins/.*\\.lua$/"],
      "matchStrings": [
        "\"(?<depName>[^\"]+/[^\"]+)\"\\s*,\\s*(?:[^}]*?)?(?:version|tag)\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "description": "lazy.nvim commit pin updates",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)lua/plugins/.*\\.lua$/"],
      "matchStrings": [
        "\"(?<depName>[^\"]+/[^\"]+)\"\\s*,[\\s\\S]*?commit\\s*=\\s*\"(?<currentDigest>[a-f0-9]{7,40})\""
      ],
      "packageNameTemplate": "https://github.com/{{depName}}",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    }
  ],

  "packageRules": [
    {
      "description": "Auto-merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge minor nvim plugins",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true,
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["git-refs", "github-tags"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ]
}

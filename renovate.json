{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended"],

  "customDatasources": {
    "nvim-plugin": {}
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "lazy.nvim plugin tag/version updates",
      "managerFilePatterns": ["(^|/)lua/plugins/.*\\.lua$"],
      "matchStrings": [
        "\\{\\s*\"(?<depName>[^\\\"]+/[^\\\"]+)\".*?(?:version|tag)\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "lazy.nvim commit pin updates",
      "managerFilePatterns": ["(^|/)lua/plugins/.*\\.lua$"],
      "matchStrings": [
        "\\{\\s*\"(?<depName>[^\\\"]+/[^\\\"]+)\".*?commit\\s*=\\s*\"(?<currentValue>[a-f0-9]+)\""
      ],
      "datasourceTemplate": "github-commits",
      "versioningTemplate": "git"
    }
  ],

  "packageRules": [
    {
      "description": "Auto-merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge minor nvim plugins",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true,
      "matchDatasources": ["custom.nvim-plugin"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ]
}
